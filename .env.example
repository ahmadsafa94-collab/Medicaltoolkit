TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
ANTHROPIC_API_KEY=your_anthropic_api_key
VOYAGE_API_KEY=your_voyage_api_key
STORAGE_DIR=./storage

# Public HTTPS URL the Book Shelf mini app is served from -- set this to
# your deployed app's own domain plus "/webapp/", e.g.
# WEBAPP_URL=https://yourapp.herokuapp.com/webapp/
# Leave blank during local development; the 📚 Book Shelf button is simply
# hidden from the menu until this is set (Telegram requires a real HTTPS
# URL for web_app buttons -- it will not open http:// or localhost).
WEBAPP_URL=
# PORT is normally set automatically by your hosting platform (Heroku,
# Render, etc.) -- only set this yourself for local testing.
# PORT=8000
