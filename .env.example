TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
ANTHROPIC_API_KEY=your_anthropic_api_key
VOYAGE_API_KEY=your_voyage_api_key

# Everything this bot persists (subscriptions, library, admin logs, Ask My
# Books indexes, etc.) lives under this one directory. On a host with an
# ephemeral filesystem (Railway, Heroku, most container platforms), the
# default "./storage" is WIPED on every redeploy -- attach a persistent
# volume and point this at it before real users start using the bot, e.g.
# on Railway: Add a Volume to this service, mount it at /data, then set
# STORAGE_DIR=/data here (or as a Railway environment variable, not in this
# file, on an actual deployment).
STORAGE_DIR=./storage

# Comma-separated Telegram numeric user ids allowed into the admin panel
# (/admin) -- see config.py. A user's own id is shown to them by
# @userinfobot, or by this bot's own /whoami.
ADMIN_USER_IDS=

# Public @username (no leading "@") of the admin who should receive 🆘
# Support taps as a direct Telegram chat link. Leave blank to fall back to
# the bot-relayed "message the admin" flow instead.
SUPPORT_ADMIN_USERNAME=

# Public HTTPS URL the Book Shelf mini app is served from -- set this to
# your deployed app's own domain plus "/webapp/", e.g.
# WEBAPP_URL=https://yourapp.herokuapp.com/webapp/
# Leave blank during local development; the 📚 Book Shelf button is simply
# hidden from the menu until this is set (Telegram requires a real HTTPS
# URL for web_app buttons -- it will not open http:// or localhost).
WEBAPP_URL=
# PORT is normally set automatically by your hosting platform (Heroku,
# Render, etc.) -- only set this yourself for local testing.
# PORT=8000
